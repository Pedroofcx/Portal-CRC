{
  "name": "Curso",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do curso"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do curso"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria do curso"
    },
    "carga_horaria": {
      "type": "number",
      "description": "Carga hor\u00e1ria em horas"
    },
    "conteudo_url": {
      "type": "string",
      "description": "URL do conte\u00fado/material"
    },
    "obrigatorio": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 curso obrigat\u00f3rio"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "data_criacao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "titulo",
    "descricao"
  ]
}