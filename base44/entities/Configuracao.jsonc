{
  "name": "Configuracao",
  "type": "object",
  "properties": {
    "chave": {
      "type": "string",
      "description": "Chave \u00fanica da configura\u00e7\u00e3o"
    },
    "valor": {
      "type": "string",
      "description": "Valor da configura\u00e7\u00e3o (JSON stringified para objetos)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "texto",
        "numero",
        "boolean",
        "json",
        "lista"
      ],
      "description": "Tipo do valor"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "geral",
        "metas",
        "categorias",
        "sla",
        "governanca"
      ],
      "description": "Categoria da configura\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da configura\u00e7\u00e3o"
    }
  },
  "required": [
