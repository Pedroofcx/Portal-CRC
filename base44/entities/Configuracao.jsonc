{
  "name": "Configuracao",
  "type": "object",
  "properties": {
    "chave": {
      "type": "string",
      "description": "Chave única da configuração"
    },
    "valor": {
      "type": "string",
      "description": "Valor da configuração (JSON stringified para objetos)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "texto",
        "numero",
        "boolean",
        "json",
        "lista"
      ],
      "description": "Tipo do valor"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "geral",
        "metas",
        "categorias",
        "sla",
        "governanca",
        "ranking"
      ],
      "description": "Categoria da configuração"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição da configuração"
    }
  },
  "required": [
    "chave",
    "valor",
    "tipo",
    "categoria"
  ]
}