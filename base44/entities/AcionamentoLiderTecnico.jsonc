{
  "name": "AcionamentoLiderTecnico",
  "type": "object",
  "properties": {
    "tratativa_id": {
      "type": "string",
      "description": "ID da Tratativa vinculada"
    },
    "tratativa_id_interno": {
      "type": "string",
      "description": "ID interno da tratativa (TRT-XXXX)"
    },
    "tratativa_nome_cliente": {
      "type": "string",
      "description": "Nome do cliente da tratativa"
    },
    "lider_tecnico_id": {
      "type": "string",
      "description": "ID do L\u00edder T\u00e9cnico acionado"
    },
    "lider_tecnico_nome": {
      "type": "string",
      "description": "Nome do L\u00edder T\u00e9cnico acionado"
    },
    "lider_tecnico_ordem": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o do l\u00edder no rod\u00edzio no momento do acionamento"
    },
    "tipo_acionamento": {
      "type": "string",
      "enum": [
        "rodizio",
        "supervisor"
      ],
      "description": "Tipo de acionamento: rod\u00edzio autom\u00e1tico ou escolha de supervisor"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que realizou o acionamento"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que realizou o acionamento"
    },
    "status_lider_momento": {
      "type": "string",
      "enum": [
        "permitido",
        "ferias",
        "bloqueado"
      ],
      "description": "Status do l\u00edder no momento do acionamento"
    },
    "data_acionamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do acionamento"
    }
  },
  "required": [
    "tratativa_id",
    "lider_tecnico_id",
    "tipo_acionamento",
    "data_acionamento"
  ]
}