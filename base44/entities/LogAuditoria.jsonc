{
  "name": "LogAuditoria",
  "type": "object",
  "properties": {
    "acao": {
      "type": "string",
      "enum": [
        "criar",
        "editar",
        "excluir",
        "visualizar",
        "exportar",
        "login",
        "logout"
      ],
      "description": "Tipo de a\u00e7\u00e3o"
    },
    "modulo": {
      "type": "string",
      "description": "M\u00f3dulo onde ocorreu"
    },
    "entidade": {
      "type": "string",
      "description": "Entidade afetada"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID da entidade afetada"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "usuario_papel": {
      "type": "string",
      "description": "Papel do usu\u00e1rio"
    },
    "dados_anteriores": {
      "type": "string",
      "description": "JSON dos dados antes da altera\u00e7\u00e3o"
    },
    "dados_novos": {
      "type": "string",
      "description": "JSON dos dados ap\u00f3s a altera\u00e7\u00e3o"
    },
    "ip": {
      "type": "string",
      "description": "IP do usu\u00e1rio"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da a\u00e7\u00e3o (S\u00e3o Paulo)"
    }
  },
  "required": [
    "acao",
    "modulo",
    "usuario_id"
  ]
}