{
  "name": "SolicitacaoFerias",
  "type": "object",
  "properties": {
    "colaborador_id": {
      "type": "string",
      "description": "ID do colaborador solicitante"
    },
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador"
    },
    "colaborador_funcao": {
      "type": "string",
      "description": "Fun\u00e7\u00e3o do colaborador (para controle de staff)"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio das f\u00e9rias"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de retorno ao trabalho"
    },
    "dias_corridos": {
      "type": "number",
      "description": "Total de dias corridos"
    },
    "dias_uteis": {
      "type": "number",
      "description": "Total de dias \u00fateis"
    },
    "periodo_aquisitivo_inicio": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio do per\u00edodo aquisitivo"
    },
    "periodo_aquisitivo_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim do per\u00edodo aquisitivo"
    },
    "periodo_concessivo_inicio": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio do per\u00edodo concessivo"
    },
    "periodo_concessivo_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim do per\u00edodo concessivo"
    },
    "tipo_fracionamento": {
      "type": "string",
      "enum": [
        "integral",
        "fracionado_2",
        "fracionado_3"
      ],
      "default": "integral",
      "description": "Tipo de fracionamento"
    },
    "fracionamento_numero": {
      "type": "number",
      "description": "N\u00famero da fra\u00e7\u00e3o (1, 2 ou 3)"
    },
    "venda_dias": {
      "type": "number",
      "default": 0,
      "description": "Dias vendidos (abono pecuni\u00e1rio, m\u00e1x 10)"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_analise",
        "aprovada",
        "recusada",
        "sugestao_nova_data",
        "cancelada"
      ],
      "default": "em_analise",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "aprovador_id": {
      "type": "string",
      "description": "ID do gestor/RH que aprovou"
    },
    "aprovador_nome": {
      "type": "string",
      "description": "Nome do aprovador"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da aprova\u00e7\u00e3o/recusa"
    },
    "motivo_recusa": {
      "type": "string",
      "description": "Motivo da recusa (obrigat\u00f3rio se recusada)"
    },
    "sugestao_nova_data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data sugerida pelo gestor"
    },
    "sugestao_nova_data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data fim sugerida"
    },
    "observacoes_gestor": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do gestor"
    },
    "observacoes_colaborador": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do colaborador"
    },
    "validacoes_aplicadas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regra": {
            "type": "string"
          },
          "aprovada": {
            "type": "boolean"
          },
          "mensagem": {
            "type": "string"
          }
        }
      },
      "description": "Valida\u00e7\u00f5es executadas pelo sistema"
    },
    "conflitos_detectados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Conflitos com outras solicita\u00e7\u00f5es"
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da solicita\u00e7\u00e3o"
    },
    "versao_regra": {
      "type": "string",
      "default": "1.0",
      "description": "Vers\u00e3o da regra aplicada"
    },
    "adicional_um_terco": {
      "type": "number",
      "description": "Valor do adicional de 1/3"
    },
    "data_limite_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data limite para pagamento (2 dias antes)"
    },
    "staff_critico": {
      "type": "boolean",
      "default": false,
      "description": "Se o colaborador \u00e9 staff cr\u00edtico"
    },
    "historico": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acao": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "detalhes": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de a\u00e7\u00f5es"
    }
  },
  "required": [
    "colaborador_id",
    "data_inicio",
    "data_fim",
    "periodo_aquisitivo_inicio",
    "periodo_aquisitivo_fim"
  ]
}