{
  "name": "PDI",
  "type": "object",
  "properties": {
    "colaborador_id": {
      "type": "string",
      "description": "ID do colaborador"
    },
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do PDI"
    },
    "objetivo_geral": {
      "type": "string",
      "description": "Objetivo geral do plano"
    },
    "etapas": {
      "type": "array",
      "description": "Etapas do PDI",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "conteudo_profissional": {
            "type": "string"
          },
          "prazo": {
            "type": "string",
            "format": "date"
          },
          "concluida": {
            "type": "boolean",
            "default": false
          },
          "data_conclusao": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "em_andamento",
        "concluido",
        "cancelado"
      ],
      "default": "em_andamento"
    },
    "data_criacao": {
      "type": "string",
      "format": "date-time"
    },
    "criado_por_id": {
      "type": "string"
    },
    "criado_por_nome": {
      "type": "string"
    },
    "percentual_conclusao": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "colaborador_id",
    "titulo",
    "objetivo_geral"
  ]
}