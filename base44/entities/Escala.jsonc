{
  "name": "Escala",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da chave de escala"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da escala"
    },
    "turnos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "hora_inicio": {
            "type": "string"
          },
          "hora_fim": {
            "type": "string"
          },
          "dias_semana": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "description": "Turnos da escala"
    },
    "ativa": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome"
  ]
}