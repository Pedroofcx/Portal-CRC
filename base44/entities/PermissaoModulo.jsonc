{
  "name": "PermissaoModulo",
  "type": "object",
  "properties": {
    "modulo_nome": {
      "type": "string",
      "description": "Nome do m\u00f3dulo (Dashboard, Tratativas, etc)"
    },
    "modulo_rota": {
      "type": "string",
      "description": "Rota do m\u00f3dulo no sistema"
    },
    "visivel_para_agente": {
      "type": "boolean",
      "default": true,
      "description": "Se o m\u00f3dulo est\u00e1 vis\u00edvel para agentes"
    },
    "visivel_para_gestor": {
      "type": "boolean",
      "default": true,
      "description": "Se o m\u00f3dulo est\u00e1 vis\u00edvel para gestores"
    },
    "colaboradores_excecao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de colaboradores com permiss\u00e3o customizada"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o no menu"
    },
    "icone": {
      "type": "string",
      "description": "Nome do \u00edcone lucide-react"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "modulo_nome",
    "modulo_rota"
  ]
}