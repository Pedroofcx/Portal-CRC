{
  "name": "Pesquisa",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da pesquisa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da pesquisa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "csat",
        "nps",
        "ces",
        "clima_organizacional",
        "personalizada"
      ],
      "description": "Tipo de pesquisa"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "cliente",
        "interna"
      ],
      "default": "interna",
      "description": "Categoria da pesquisa"
    },
    "perguntas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "texto": {
            "type": "string"
          },
          "tipo_resposta": {
            "type": "string",
            "enum": [
              "escala_1_5",
              "escala_0_10",
              "texto",
              "sim_nao",
              "multipla_escolha",
              "multipla_escolha_multipla"
            ]
          },
          "opcoes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "obrigatoria": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "ativa": {
      "type": "boolean",
      "default": true
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim": {
      "type": "string",
      "format": "date"
    },
    "agendamento": {
      "type": "object",
      "properties": {
        "ativo": {
          "type": "boolean",
          "default": false
        },
        "tipo": {
          "type": "string",
          "enum": [
            "unico",
            "semanal",
            "quinzenal",
            "mensal",
            "personalizado"
          ],
          "description": "Tipo de recorr\u00eancia"
        },
        "data_hora_envio": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora do envio (\u00fanico ou primeiro envio)"
        },
        "intervalo_dias": {
          "type": "number",
          "description": "Intervalo em dias para recorr\u00eancia personalizada"
        },
        "prazo_resposta_dias": {
          "type": "number",
          "default": 7,
          "description": "Prazo em dias para responder"
        },
        "enviar_lembrete": {
          "type": "boolean",
          "default": true
        },
        "dias_antes_lembrete": {
          "type": "number",
          "default": 2,
          "description": "Dias antes do prazo para enviar lembrete"
        }
      }
    },
    "requer_confirmacao_leitura": {
      "type": "boolean",
      "default": true,
      "description": "Se requer que o agente confirme que leu antes de responder"
    },
    "peso_health_score": {
      "type": "number",
      "default": 0,
      "description": "Peso desta pesquisa no c\u00e1lculo do Health Score (0-10)"
    },
    "publicada": {
      "type": "boolean",
      "default": false,
      "description": "Se a pesquisa foi publicada para os agentes"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da publica\u00e7\u00e3o"
    },
    "criado_por_id": {
      "type": "string"
    },
    "criado_por_nome": {
      "type": "string"
    },
    "reenviar_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp do \u00faltimo reenvio for\u00e7ado para todos"
    }
  },
  "required": [
    "titulo",
    "tipo",
    "perguntas"
  ]
}