{
  "name": "SaldoFerias",
  "type": "object",
  "properties": {
    "colaborador_id": {
      "type": "string",
      "description": "ID do colaborador"
    },
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador"
    },
    "data_admissao": {
      "type": "string",
      "format": "date",
      "description": "Data de admiss\u00e3o"
    },
    "periodos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "aquisitivo_inicio": {
            "type": "string",
            "format": "date"
          },
          "aquisitivo_fim": {
            "type": "string",
            "format": "date"
          },
          "concessivo_inicio": {
            "type": "string",
            "format": "date"
          },
          "concessivo_fim": {
            "type": "string",
            "format": "date"
          },
          "dias_totais": {
            "type": "number",
            "default": 30
          },
          "dias_utilizados": {
            "type": "number",
            "default": 0
          },
          "dias_vendidos": {
            "type": "number",
            "default": 0
          },
          "dias_disponiveis": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "em_aquisicao",
              "disponivel",
              "vencendo_30d",
              "vencendo_60d",
              "vencendo_90d",
              "vencido",
              "utilizado"
            ]
          },
          "vencido": {
            "type": "boolean",
            "default": false
          },
          "dias_vencimento": {
            "type": "number"
          }
        }
      },
      "description": "Per\u00edodos aquisitivos e concessivos"
    },
    "staff_critico": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 staff/fun\u00e7\u00e3o cr\u00edtica"
    },
    "ultima_atualizacao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "colaborador_id",
    "data_admissao"
  ]
}