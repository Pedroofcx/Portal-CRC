{
  "name": "SolicitacaoApoio",
  "type": "object",
  "properties": {
    "tipo_apoio": {
      "type": "string",
      "enum": [
        "treinamento",
        "consultoria",
        "implantacao",
        "outro"
      ],
      "description": "Tipo de apoio solicitado"
    },
    "tipo_apoio_outro": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o quando tipo_apoio = outro"
    },
    "tipo_zendesk": {
      "type": "string",
      "description": "N\u00famero/identificador do ticket Zendesk"
    },
    "nome_cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "cnpj_cliente": {
      "type": "string",
      "description": "CNPJ do cliente"
    },
    "operador_id": {
      "type": "string",
      "description": "ID do colaborador respons\u00e1vel"
    },
    "operador_nome": {
      "type": "string",
      "description": "Nome do operador respons\u00e1vel"
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date",
      "description": "Data da solicita\u00e7\u00e3o"
    },
    "tratativa_id": {
      "type": "string",
      "description": "ID da Tratativa CRC vinculada"
    },
    "vinculo_crc": {
      "type": "string",
      "description": "ID interno da tratativa vinculada (TRT-XXXX)"
    },
    "descricao_justificativa": {
      "type": "string",
      "description": "Dificuldade do cliente, motivo do apoio, o que precisa ser feito"
    },
    "horas_solicitadas": {
      "type": "number",
      "description": "Horas solicitadas (1, 2 ou 3)"
    },
    "minutos_solicitados": {
      "type": "number",
      "description": "Horas convertidas em minutos para c\u00e1lculo de saldo"
    },
    "status": {
      "type": "string",
      "enum": [
        "solicitada",
        "em_analise",
        "aprovada",
        "em_execucao",
        "concluida",
        "cancelada"
      ],
      "default": "solicitada",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "historico_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de altera\u00e7\u00f5es de status"
    },
    "mes_referencia": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia no formato YYYY-MM para controle mensal"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "tipo_apoio",
    "nome_cliente",
    "data_solicitacao",
    "descricao_justificativa",
    "horas_solicitadas",
    "status"
  ]
}