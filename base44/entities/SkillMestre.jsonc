{
  "name": "SkillMestre",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da skill"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "soft",
        "hard"
      ],
      "description": "Tipo de skill"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da skill"
    },
    "ativa": {
      "type": "boolean",
      "default": true
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "nome",
    "tipo"
  ]
}