{
  "name": "Pontuacao",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": ["bonus_manual"],
      "description": "bonus_manual = pontos lançados pelo gestor para um ciclo (migration 17). Vazio nos registros antigos."
    },
    "ciclo_id": {
      "type": "string",
      "description": "ID do ciclo trimestral (ciclo_trimestral) a que o bônus pertence"
    },
    "descricao": {
      "type": "string",
      "description": "Motivo do bônus, escrito pelo gestor"
    },
    "lancado_por_id": {
      "type": "string",
      "description": "ID do colaborador (gestor) que lançou o bônus"
    },
    "lancado_por_nome": {
      "type": "string",
      "description": "Nome de quem lançou o bônus"
    },
    "colaborador_id": {
      "type": "string",
      "description": "ID do colaborador"
    },
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador"
    },
    "periodo_trimestre": {
      "type": "string",
      "description": "Trimestre de refer\u00eancia (ex: 2024-Q1)"
    },
    "pontos_reclamacoes_internas": {
      "type": "number",
      "default": 0,
      "description": "Pontos de reclama\u00e7\u00f5es internas"
    },
    "pontos_reclame_aqui": {
      "type": "number",
      "default": 0,
      "description": "Pontos do Reclame Aqui"
    },
    "pontos_google": {
      "type": "number",
      "default": 0,
      "description": "Pontos do Google Meu Neg\u00f3cio"
    },
    "pontos_contestacao": {
      "type": "number",
      "default": 0,
      "description": "Pontos de contesta\u00e7\u00f5es"
    },
    "pontos_csat": {
      "type": "number",
      "default": 0,
      "description": "Pontos de CSAT"
    },
    "pontos_performance": {
      "type": "number",
      "default": 0,
      "description": "Pontos de performance"
    },
    "pontos_avaliacao_cx": {
      "type": "number",
      "default": 0,
      "description": "Pontos de avalia\u00e7\u00e3o CX"
    },
    "total_pontos": {
      "type": "number",
      "default": 0,
      "description": "Total de pontos no trimestre"
    },
    "detalhamento": {
      "type": "array",
      "description": "Detalhamento de cada pontua\u00e7\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "pontos": {
            "type": "number"
          },
          "descricao": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "tratativa_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "colaborador_id",
    "periodo_trimestre"
  ]
}